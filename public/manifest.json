{
  "manifest_version": 3,
  "name": "Falari Wallet",
  "version": "1.0.0",
  "description": "Falari Browser Extension Wallet - AI-Ready Decentralized Storage Chain",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Falari Wallet",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/popup/index.html?mode=sidepanel"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "notifications",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://falari.io/*",
    "https://*.falari.io/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:*/*",
        "http://127.0.0.1:*/*",
        "https://falari.io/*",
        "https://*.falari.io/*"
      ],
      "js": ["src/content/bridge.ts"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content/inject.ts"],
      "matches": [
        "http://localhost:*/*",
        "http://127.0.0.1:*/*",
        "https://falari.io/*",
        "https://*.falari.io/*"
      ]
    }
  ]
}
